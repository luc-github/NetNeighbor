{
  "name_rules": {
    "fallback_fields": [
      "friendlyName",
      "displayName"
    ],
    "prefer_display_name_when_no_friendly_name": true
  },
  "information_rules": {
    "concat_fields": [
      "roomName",
      "displayName"
    ],
    "separator": " / "
  },
  "type_rules": [
    {
      "contains_any": [
        "smartspeaker-audio",
        "sonos"
      ],
      "type": "smartspeaker"
    },
    {
      "contains_any": [
        "dial-multiscreen",
        "chromecast",
        "googletv",
        "android tv"
      ],
      "type": "smarttv"
    },
    {
      "contains_any": [
        "camera",
        "onvif",
        "ipcam",
        "surveillance"
      ],
      "type": "camera"
    },
    {
      "contains_any": [
        "washer",
        "dryer",
        "refrigerator",
        "oven",
        "dishwasher",
        "home appliance"
      ],
      "type": "homeappliance"
    },
    {
      "contains_any": [
        "cnc",
        "grbl",
        "fluidnc",
        "laser",
        "milling",
        "cutter"
      ],
      "type": "cnc"
    },
    {
      "contains_any": [
        "3d printer",
        "3dprinter",
        "repetier",
        "marlin",
        "smoothieware",
        "klipper",
        "octoprint",
        "ultimaker",
        "prusa",
        "bambu"
      ],
      "type": "3dprinter"
    },
    {
      "_comment": "ESP3D fallback: an ESP3D controller (friendlyName 'esp3d' or modelNumber 'ESP3D x.x') with no machine-specific keyword above stays an ESP3D Device rather than 'unknown'. Placed after cnc/3dprinter so a configured target wins.",
      "contains_any": [
        "esp3d"
      ],
      "type": "esp32"
    },
    {
      "contains_any": [
        "iot",
        "smart device",
        "smartdevice"
      ],
      "type": "smartdevice"
    },
    {
      "contains_any": [
        "printer-network",
        "ipp",
        "ipps",
        "airprint",
        "network printer",
        "print service",
        "urn:schemas-upnp-org:device:printer"
      ],
      "type": "networkprinter"
    },
    {
      "contains_any": [
        "wifialliance",
        "wfadevice",
        "wfawlanconfig"
      ],
      "type": "router"
    },
    {
      "contains_any": [
        "synology",
        "qnap",
        "nas"
      ],
      "type": "nas"
    }
  ],
  "_base_type_rules_doc": "Coarse fallbacks, evaluated by _infer_type against a NARROW haystack (ST/USN/SERVER/modelName/manufacturer only — NOT friendly/room names) so loose tokens like 'wan' don't match free-form device names. These fire only when no curated type_rules above matched. modelType==nas is exact and first so a DLNA-capable NAS stays 'nas'.",
  "base_type_rules": [
    {
      "equals_field": {
        "modelType": [
          "nas"
        ]
      },
      "type": "nas"
    },
    {
      "contains_any": [
        "sonos"
      ],
      "type": "mediaserver"
    },
    {
      "contains_any": [
        "mediaserver",
        "contentdirectory",
        "mediarenderer",
        "dial-multiscreen",
        "urn:dial-multiscreen-org:service:dial",
        "googletv",
        "android tv",
        "chromecast"
      ],
      "type": "mediaserver"
    },
    {
      "contains_any": [
        "wan",
        "internetgatewaydevice",
        "router",
        "gateway",
        "wifialliance",
        "wfadevice",
        "wfawlanconfig"
      ],
      "type": "router"
    },
    {
      "contains_any": [
        "synology",
        "qnap",
        "nas"
      ],
      "type": "nas"
    },
    {
      "contains_any": [
        "printer"
      ],
      "type": "printer"
    },
    {
      "contains_any": [
        "basic",
        "computer"
      ],
      "type": "computer"
    }
  ]
}
